# Public site URL used for canonical URLs, sitemap and social metadata.
# Set this to the final production domain, for example: https://courtflux.example
NEXT_PUBLIC_SITE_URL=https://your-courtflux-domain.example

# Server-only variables. Configure these in Vercel Project Settings > Environment Variables.
# WORKER_API_URL must be a public HTTPS URL that reaches your Python worker.
WORKER_API_URL=https://your-worker.example.com
WORKER_API_TOKEN=replace-with-a-long-random-secret

# Supabase browser/session configuration.
NEXT_PUBLIC_SUPABASE_URL=https://pmpujloaixzztnrqnhbx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_z6FkJpfEOc7rLLjVLuXZkg_F34unklB

# Server-only Supabase admin key. Never expose this as NEXT_PUBLIC_* and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
