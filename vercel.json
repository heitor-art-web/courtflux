{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "web/.next",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "env": {
    "VERCEL_PREVIEW_FEEDBACK_ENABLED": "0"
  },
  "build": {
    "env": {
      "VERCEL_PREVIEW_FEEDBACK_ENABLED": "0"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
