    "real_team_names_in_scoring": false,
    "scoring_unit": "one human-attributable event window or one human-verified possession interval",
    "possessed_prediction_source": "for clips without explicit possession_intervals, modal non-unknown current_team_id inside the human window; when possession_intervals are present, only those intervals are possession scoring truth",
    "possession_interval_policy": "possession interval boundaries and team side must come from human review; model predictions must never define or expand ground-truth possession intervals",
